@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Protobuf REQUIRED)

if(@MQSS_ENABLE_MPI_TRANSPORT@)
  find_dependency(MPI REQUIRED COMPONENTS CXX)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/mqssTargets.cmake")

check_required_components(mqss)
